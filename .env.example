# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable is validated in src/env.ts.

# Contentful (Settings → API keys in the Contentful web app)
CONTENTFUL_SPACE_ID=
# "master" unless you work against another Contentful environment
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API token: published content
CONTENTFUL_DELIVERY_TOKEN=
# Content Preview API token: drafts, used only in draft mode
CONTENTFUL_PREVIEW_TOKEN=
# Content Management API token: only for `npm run contentful:migrate` / `contentful:seed-posts`.
# The website never reads it. Create one under avatar → Account settings → CMA tokens.
# Keep it local (and in CI secrets later); never commit it or paste it anywhere else.
CONTENTFUL_MANAGEMENT_TOKEN=

# Optional, read by src/lib/site.ts (not src/env.ts). The live site's address, without a
# trailing slash, for canonical URLs, share links, the sitemap, and structured data.
# Leave it empty to use https://inkpixelstudios.com.
NEXT_PUBLIC_SITE_URL=

# Contact forms (src/lib/send-enquiry.ts): the mailbox they send through. Optional; without them
# the forms offer the visitor's email app instead. Live server only. From cPanel → Email Accounts
# → info@inkpixelstudios.com → Connect Devices (outgoing server).
SMTP_HOST=
# 465 (SSL/TLS, the default) or 587 (STARTTLS)
SMTP_PORT=465
SMTP_USER=info@inkpixelstudios.com
SMTP_PASSWORD=
# Optional: where enquiries go (default info@inkpixelstudios.com)
CONTACT_TO=

# "true" on the live server only (read at build time): lets search engines index the site.
# Leave empty locally and on the demo.
ALLOW_INDEXING=
