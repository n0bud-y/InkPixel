# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable is validated in src/env.ts.

# Contentful (Settings → API keys in the Contentful web app)
CONTENTFUL_SPACE_ID=
# "master" unless you work against another Contentful environment
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API token: published content
CONTENTFUL_DELIVERY_TOKEN=
# Content Preview API token: drafts, used only in draft mode
CONTENTFUL_PREVIEW_TOKEN=
